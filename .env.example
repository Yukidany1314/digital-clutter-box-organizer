# GEMINI_API_KEY: Injected automatically by AI Studio at runtime from user secrets.
GEMINI_API_KEY=""

# GEMINI_MODEL: Default Gemini model for categorization and organization assistant.
GEMINI_MODEL="gemini-3.8-flash"

# Port and App URL
PORT="3000"
APP_URL="http://localhost:3000"

# Supabase Configuration (Optional for cloud sync; if not provided, local persistence is used seamlessly)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# ClutterBox Configuration
FORGOTTEN_THRESHOLD_DAYS="14"
